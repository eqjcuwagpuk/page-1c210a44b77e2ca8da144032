32px rgba(11,36,64,.55)}\n  .client h3{font-size:18px;color:var(--navy)}\n  .client .meta{margin-top:6px;font-size:12.8px;letter-spacing:.12em;text-transform:uppercase;color:#a8781f;font-weight:700}\n  .client p{margin-top:12px;font-size:14.8px;color:var(--muted)}\n  .client .status{display:inline-block;margin-top:16px;font-size:13px;padding:4px 12px;border-radius:999px;background:#e8ecf1;color:#3d5062}\n\n  /* ---------- FAQ ---------- */\n  .faq{background:var(--paper)}\n  .faq-group{margin-top:44px}\n  .faq-group + .faq-group{margin-top:38px}\n  .faq-group h3{font-size:15px;letter-spacing:.14em;text-transform:uppercase;color:var(--navy);padding-bottom:12px;border-bottom:2px solid var(--amber);display:inline-block}\n  .qa-grid{margin-top:22px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}\n  .qa{background:#fff;border-radius:18px;padding:22px 24px;box-shadow:0 18px 38px -34px rgba(11,36,64,.6)}\n  .qa h4{font-size:16.5px;color:var(--navy)}\n  .qa p{margin-top:10px;font-size:14.8px;color:var(--muted)}\n\n  /* ---------- FOOTER ---------- */\n  footer{background:var(--navy-deep);color:#9fb3c6;padding:44px 0 40px;font-size:13.8px}\n  .foot-top{display:flex;flex-wrap:wrap;gap:16px 30px;justify-content:space-between;align-items:baseline;border-bottom:1px solid rgba(255,255,255,.12);padding-bottom:20px}\n  .foot-brand{font-size:18px;font-weight:700;color:#fff}\n  .foot-brand span{color:var(--amber)}\n  .foot-links{display:flex;flex-wrap:wrap;gap:8px 22px}\n  .foot-links a{color:#c3d3e2}\n  .foot-links a:hover,.foot-links a:focus{color:var(--amber)}\n  .foot-note{margin-top:20px;max-width:60em;line-height:1.75}\n\n  /* ---------- RESPONSIVE ---------- */\n  @media (max-width:900px){.hero-grid{grid-template-columns:1fr;gap:36px;margin-top:40px;}\n    .plan{grid-template-columns:1fr;gap:18px;}\n    .plan:nth-child(1),.plan:nth-child(2){margin-right:0;}\n    .steps{grid-template-columns:1fr;}\n    .client-grid,.qa-grid{grid-template-columns:1fr;}}\n  @media (max-width:560px){\n    section{padding:56px 0}\n    .hero{padding:26px 0 48px}\n    .panel{padding:22px 20px}\n    .plan{padding:24px 20px 26px}\n    .plan-price{font-size:26px}\n    .qa{padding:20px 18px}\n  }\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-top\">\n        <div class=\"brandmark\">售后云 <span>☁️</span></div>\n        <div class=\"hero-tag\">套餐 · 客户端 · 常见问题</div>\n      </div>\n\n      <nav class=\"anchors\" aria-label=\"页面内锚点\">\n        <a href=\"#usage\">使用说明</a>\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n\n      <div class=\"hero-grid\">\n        <div class=\"hero-copy\">\n          <h1>售后云(☁️) · 售后云 ☁️<br>把订阅这件事<em>说清楚</em></h1>\n          <p class=\"hero-lead\">三档订阅，一份说明书。你不需要先懂术语，再决定要不要用。</p>\n          <p class=\"hero-lead\">本页写清每档套餐包含什么、客户端需要做哪些准备、以及遇到问题先看哪里。所有内容以页面正文为准。</p>\n          <ul class=\"hero-notes\">\n            <li>套餐按月、按年两种计费方式</li>\n            <li>客户端准备步骤写在正文里</li>\n            <li>常见问题按主题分组</li>\n          </ul>\n        </div>\n\n        <aside class=\"panel\" aria-label=\"关键信息速览\">\n          <h2>一眼看完</h2>\n          <ul class=\"panel-list\">\n            <li><span>可选套餐</span><b>三档</b></li>\n            <li><span>基础版月付</span><b>¥15 / 月</b></li>\n            <li><span>旗舰版月付</span><b>¥35 / 月</b></li>\n            <li><span>团队版月付</span><b>¥85 / 月</b></li>\n            <li><span>设备额度</span><b>3 / 5 / 20 台</b></li>\n            <li><span>流量额度</span><b>100 / 300 / 1000 GB</b></li>\n          </ul>\n          <p class=\"panel-foot\">年付价格与月付价的对应关系写在套餐区块内。未在本页出现的信息，我们不替你补全。</p>\n        </aside>\n      </div>\n    </div>\n  </header>\n\n  <section class=\"usage\" id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"kicker\">使用说明</div>\n        <h2>三步走完：选套餐、装客户端、核对信息</h2>\n        <p>顺序不复杂，但每一步都建议读完再动手。以下步骤不含任何隐藏条件。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"step-num\">步骤 01</div>\n          <h3>先定套餐，再谈其他</h3>\n          <p>看两件事：同时在线的设备数、每月流量额度。设备多就往上选一档，流量够用就别加价。团队场景先确认人数和路由需求，再决定是否进入团队版。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"step-num\">步骤 02</div>\n          <h3>准备好客户端环境</h3>\n          <p>在要使用的设备上留出安装空间，确认系统版本可用、网络能正常访问。安装与配置方式以客户端内提供的说明为准，本页不提供下载地址。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"step-num\">步骤 03</div>\n          <h3>核对套餐与设备数</h3>\n          <p>启用后先核对账户下的套餐名称、计费周期与可在线设备数是否与所选一致。任一项不符，先停在核对环节，不要继续添加设备。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"plans\" id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"kicker\">套餐</div>\n        <h2>三档递进，按需往上走</h2>\n        <p>从基础版到团队版，额度、设备数与支持方式逐级提升。年付价格单独标注，不打包其他承诺。</p>\n      </div>\n\n      <div class=\"ladder\">\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-name\">基础版</div>\n            <div class=\"plan-price\">¥15 / 月<small>按年付 ¥150 / 年</small></div>\n            <p class=\"plan-desc\">单人自用，设备不多，需求集中在基础访问与流媒体。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-flag\">多数人从这里开始</div>\n          <div>\n            <div class=\"plan-name\">旗舰版</div>\n            <div class=\"plan-price\">¥35 / 月<small>按年付 ¥350 / 年</small></div>\n            <p class=\"plan-desc\">多设备日常使用，需要更完整的流媒体解锁与更稳定的线路选择。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-name\">团队版</div>\n            <div class=\"plan-price\">¥85 / 月<small>按年付 ¥850 / 年</small></div>\n            <p class=\"plan-desc\">多人共用，需要更大的流量池、更多设备与可定制的路由方案。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"plans-note\">以上价格为页面展示价，计费周期分月付与年付两种。流量额度与设备数以所选套餐为准；超出设备数或流量的处理方式，请以下单时页面显示的实际条款为准。本页不承诺任何未列出的性能或可用性指标。</p>\n    </div>\n  </section>\n\n  <section class=\"clients\" id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"kicker\">客户端</div>\n        <h2>客户端准备：按设备类型分开看</h2>\n        <p>不同设备需要的准备工作不同。以下是各类客户端的准备要点，具体安装包与配置参数以实际提供渠道为准。</p>\n      </div>\n\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <div class=\"meta\">桌面端</div>\n          <h3>Windows 与 macOS</h3>\n          <p>适合长时间在线的主力设备。安装前确认系统版本可用、磁盘留出安装空间；同一账户在多台桌面设备登录时，会计入套餐的设备数上限。</p>\n          <span class=\"status\">安装包与配置以实际渠道为准</span>\n        </article>\n\n        <article class=\"client\">\n          <div class=\"meta\">移动端</div>\n          <h3>iOS 与 Android</h3>\n          <p>适合随身使用。首次使用前确认系统网络设置可正常调整；移动端与桌面端共用同一个设备额度，切换设备前建议先确认当前在线数量。</p>\n          <span class=\"status\">安装与配置以客户端内说明为准</span>\n        </article>\n\n        <article class=\"client\">\n          <div class=\"meta\">多设备协同</div>\n          <h3>同时在线管理</h3>\n          <p>同时在线设备数由套餐决定：基础版 3 台、旗舰版 5 台、团队版 20 台。设备数接近上限时，优先清理不再使用的设备，再添加新设备。</p>\n          <span class=\"status\">额度见套餐区块</span>\n        </article>\n\n        <article class=\"client\">\n          <div class=\"meta\">团队场景</div>\n          <h3>多人共用与路由</h3>\n          <p>团队版支持企业定制路由，适合有固定使用人群的组织。部署前先确定使用人数与设备清单，再据此决定是否需要专属客户经理协助。</p>\n          <span class=\"status\">需先确认人数与路由需求</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"faq\" id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"kicker\">常见问题</div>\n        <h2>按主题分组的问题与答案</h2>\n        <p>先看你关心的是哪一类：套餐与计费、客户端与设备、使用与支持。答案尽量短，不做额外承诺。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>套餐与计费</h3>\n        <div class=\"qa-grid\">\n          <article class=\"qa\">\n            <h4>月付和年付有什么区别？</h4>\n            <p>计费周期不同。基础版月付 ¥15、年付 ¥150；旗舰版月付 ¥35、年付 ¥350；团队版月付 ¥85、年付 ¥850。权益内容一致，差别在付款周期与节省幅度。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>该怎么判断选哪一档？</h4>\n            <p>看两个数字就够：同时在线的设备数、每月要用的流量额度。设备数 3 台以内选基础版；5 台左右选旗舰版；多人共用的团队场景再考虑团队版。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>超出设备数或流量会怎样？</h4>\n            <p>本页只列出各档额度，不描述超出后的具体处理方式。下单前请以实际页面显示的条款为准，或在使用前先核对账户内的额度信息。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>可以中途换档吗？</h4>\n            <p>本页不提供换档流程说明。如已下单，建议先确认当前套餐的计费周期与剩余额度，再按实际页面提供的操作方式处理，不要凭猜测操作。</p>\n          </article>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>客户端与设备</h3>\n        <div class=\"qa-grid\">\n          <article class=\"qa\">\n            <h4>客户端从哪里获取？</h4>\n            <p>本页不提供下载地址与安装包。请以实际提供渠道给出的客户端为准，不要从来历不明的第三方页面获取安装文件。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>一台设备算一个额度吗？</h4>\n            <p>同时在线设备数按设备计算，桌面端与移动端共用同一份额度。基础版 3 台、旗舰版 5 台、团队版 20 台，这是上限，不是平均值。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>换设备需要做什么准备？</h4>\n            <p>先确认当前在线设备数量，必要时移除不再使用的设备，再在新设备上完成安装与配置。配置方式以客户端内的说明为准。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>为什么没有看到下载链接？</h4>\n            <p>因为本页没有可靠的下载来源信息，所以不放置任何下载链接，也不写虚构地址。请通过实际渠道获取客户端与配置参数。</p>\n          </article>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>使用与支持</h3>\n        <div class=\"qa-grid\">\n          <article class=\"qa\">\n            <h4>遇到问题先看哪里？</h4>\n            <p>顺序是：先核对套餐名称与设备数，再检查客户端是否完成配置，最后查本页的常见问题分组。三步都确认过，再进入工单渠道描述问题。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>旗舰版的优先工单支持是什么？</h4>\n            <p>按套餐列表的描述，旗舰版包含 7×24 优先工单支持，团队版包含专属客户经理服务。本页不承诺响应时长，具体以实际服务条款为准。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>本页的价格是最终价吗？</h4>\n            <p>本页列出的是展示价：¥15 / ¥35 / ¥85 每月，年付为 ¥150 / ¥350 / ¥850。下单时以实际页面显示为准，本页不做额外价格承诺。</p>\n          </article>\n          <article class=\"qa\">\n            <h4>为什么没有用户评价或节点清单？</h4>\n            <p>因为本页没有可核实的信息来源，所以不写评价、不列节点、不标注性能数字。页面只写能确认的套餐与设备额度，其余留空。</p>\n          </article>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-top\">\n      <div class=\"foot-brand\">售后云 <span>☁️</span></div>\n      <nav class=\"foot-links\" aria-label=\"页脚导航\">\n        <a href=\"#usage\">使用说明</a>\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </nav>\n    </div>\n    <p class=\"foot-note\">本页为品牌说明页面，内容包含套餐展示价、权益列表、客户端准备步骤与常见问题。未在本页出现的信息，包括下载地址、节点清单、性能指标与退款规则，均不作陈述。价格与权益以实际下单页面显示为准。</p>\n  </div>\n</footer>",
